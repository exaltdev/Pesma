# Directories
IDIR = inc
SDIR = src
ODIR = $(SDIR)/obj
BDIR = build

# Compiler & flags
CC = gcc
CFLAGS = -g -I$(IDIR) -std=c99 -D_POSIX_C_SOURCE=200809L -MMD -MP
LDFLAGS = -L$(BDIR) -Wl,-rpath,'$$ORIGIN'

# Sources
SRC = $(filter-out pesma_test.c,$(notdir $(wildcard $(SDIR)/*.c)))
OBJ = $(patsubst %,$(ODIR)/%,$(SRC:.c=.o))
DEPS = $(OBJ:.o=.d) $(BDIR)/pesma_test.d
TEST = $(SDIR)/pesma_test.c

#Debug flags
CFLAGS += -Wall -Wextra -Wpedantic

SANITIZE ?= 0
ifeq ($(SANITIZE),1)
    CFLAGS  += -fsanitize=address,undefined -fno-omit-frame-pointer
    LDFLAGS += -fsanitize=address,undefined
endif

.PHONY: clean all test memcheck

# Default target
all: $(BDIR)/pesma_test

# Ensure directories exist
$(ODIR) $(BDIR):
	mkdir -p $@

# Compile object files for the library
$(ODIR)/%.o: $(SDIR)/%.c | $(ODIR)
	$(CC) -fPIC -c $< -o $@ $(CFLAGS)

# Build shared library
$(BDIR)/libpesma.so: $(OBJ)
	$(CC) -shared -o $@ $^

# Build test executable
$(BDIR)/pesma_test.o: $(TEST) | $(BDIR)
	$(CC) -c $< -o $@ $(CFLAGS)

$(BDIR)/pesma_test: $(BDIR)/pesma_test.o $(BDIR)/libpesma.so
	$(CC) -o $@ $< $(LDFLAGS) -lpesma

test: $(BDIR)/pesma_test
	./$(BDIR)/pesma_test

memcheck: $(BDIR)/pesma_test
	valgrind --leak-check=full --show-leak-kinds=all --track-origins=yes ./$(BDIR)/pesma_test

# Header dependencies (auto-generated by -MMD)
-include $(DEPS)

# Clean
clean:
	rm -rf $(ODIR) $(BDIR)
